#!/usr/bin/env python3
"""Terminal Scheduler command entry point."""

from __future__ import annotations

import sys
from typing import Optional, Sequence

from schedule_supervisor import main as supervisor_main
from schedule_update import main as update_main


def main(argv: Optional[Sequence[str]] = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    if arguments and arguments[0] == "update":
        return update_main(arguments[1:])
    return supervisor_main(arguments)


if __name__ == "__main__":
    raise SystemExit(main())
